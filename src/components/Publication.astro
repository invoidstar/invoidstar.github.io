---
import type { Publication } from '../data/content';
import type { Lang } from '../lib/routes';
interface Props { item: Publication; index: number; compact?: boolean; lang: Lang; }
const { item, index, compact = false, lang } = Astro.props;
const parts = item.authors?.split(/(Qi Chu)/g) ?? [];
const acceptedDateText = item.acceptedDate
  ? (lang === 'zh'
      ? item.acceptedDate.replaceAll('-', '.')
      : new Date(`${item.acceptedDate}T00:00:00Z`).toLocaleDateString('en-US', {
          year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
        }))
  : null;
---
<article class:list={['pub-row', compact && 'pub-row--compact']} data-area={item.area}>
  <div class="pub-index" aria-hidden="true">{String(index).padStart(2, '0')}</div>
  <div class="pub-content">
    <div class="pub-topline"><span class="pub-year">{item.year}</span><span class="pub-dot" aria-hidden="true"></span><span class="pub-category">{item.venueShort}</span></div>
    <h3 class="pub-title">{item.title}</h3>
    {item.authors && <p class="pub-authors">{parts.map((part) => part === 'Qi Chu' ? <strong>{part}</strong> : part)}</p>}
    <p class="pub-venue">{item.venue}</p>
    {acceptedDateText && <p class="pub-accepted">{lang === 'zh' ? '已录用' : 'Accepted'} · <time datetime={item.acceptedDate}>{acceptedDateText}</time></p>}
    {item.links.length > 0 && <div class="pub-actions">
      {item.links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true">↗</span></a>
      ))}
    </div>}
  </div>
</article>
