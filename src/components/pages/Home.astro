---
import type { Lang } from '../../lib/routes';
import { route, asset } from '../../lib/routes';
import { strings, email, publications, projects, researchAreas, news } from '../../data/content';
import Publication from '../Publication.astro';
import ProjectCard from '../ProjectCard.astro';
interface Props {lang: Lang;}
const {lang} = Astro.props;
const t = strings(lang);
const selectedPubs = publications.filter(p => p.featured).slice(0, 3);
const selectedProjects = projects.filter(p => p.featured).slice(0, 3);
---
<section class="home-hero" aria-labelledby="hero-name">
  <div class="shell">
    <div class="hero-topline"><span><span class="topline-sparkle">✳</span> PERSONAL WEBSITE / QI CHU</span><span>{t.heroSide}</span></div>
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="hero-eyebrow"><span class="little-orbit" aria-hidden="true"></span>{t.heroPosition}</div>
        <p class="hero-hello">{t.heroEyebrow}</p>
        <h1 id="hero-name" class="hero-name">{t.heroName}<span>{t.heroCn}</span></h1>
        <h2 class="hero-statement">{t.heroTitle} <em>{t.heroTitleEm}</em></h2>
        <p class="hero-description">{t.heroIntro}</p>
        <div class="hero-buttons">
          <a class="button button-primary" href={route('projects',lang)}>{t.heroPrimary}<span class="button-arrow" aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={'mailto:' + email}>{t.heroSecondary}<span class="button-arrow" aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-links">
          <a href="https://github.com/invoidstar" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .9A11.1 11.1 0 0 0 8.5 22.5c.55.1.75-.24.75-.53v-2.1c-3.05.66-3.7-1.28-3.7-1.28-.5-1.28-1.2-1.62-1.2-1.62-.99-.67.07-.66.07-.66 1.1.08 1.68 1.13 1.68 1.13.98 1.67 2.57 1.19 3.2.9.1-.71.39-1.19.7-1.46-2.44-.28-5-1.22-5-5.46 0-1.2.43-2.2 1.13-2.97-.11-.27-.49-1.4.11-2.93 0 0 .92-.29 3.05 1.13A10.6 10.6 0 0 1 12 6.08c.95 0 1.91.13 2.8.38 2.13-1.42 3.05-1.13 3.05-1.13.6 1.53.22 2.66.1 2.93.71.77 1.13 1.77 1.13 2.97 0 4.25-2.56 5.18-5.01 5.45.4.35.74 1.03.74 2.08v3.2c0 .29.2.64.75.53A11.1 11.1 0 0 0 12 .9Z"/></svg>GitHub</a>
          <span class="hero-link-separator" aria-hidden="true"></span>
          <a href={route('publications',lang)}>{t.nav.publications}<span aria-hidden="true">↗</span></a>
          <span class="hero-link-separator" aria-hidden="true"></span>
          <a href={route('about',lang)}>{t.nav.about}<span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-visual">
        <span class="hero-visual-decoration decoration-one" aria-hidden="true">✦</span>
        <span class="hero-visual-decoration decoration-two" aria-hidden="true">✳</span>
        <div class="portrait-frame">
          <div class="portrait-image-wrap"><img class="portrait-image" src={asset('assets/avatar.jpg')} alt={lang === 'zh' ? '沿用旧主页的粉发插画头像' : 'The illustrated avatar from my previous homepage'} width="716" height="730" fetchpriority="high" decoding="async" /></div>
          <div class="portrait-caption"><span class="portrait-caption-mark" aria-hidden="true">✧</span><span>{t.heroImgCaption}</span><span>01 / 01</span></div>
        </div>
        <div class="portrait-note"><span>INVOIDSTAR</span><span class="note-line" aria-hidden="true"></span><span>✧</span></div>
      </div>
    </div>
    <div class="hero-bottom"><span>{t.microUniversity}</span><span class="scroll-hint">{lang === 'zh' ? '向下探索' : 'SCROLL TO EXPLORE'}<span aria-hidden="true">↓</span></span></div>
  </div>
</section>

<section class="section research-section" id="research" aria-labelledby="research-heading">
  <div class="shell">
    <div class="section-heading"><div><p class="section-eyebrow">01 / RESEARCH</p><h2 id="research-heading">{t.sectionResearch}<span class="heading-sparkle" aria-hidden="true"> ✳</span></h2><p>{t.researchSubtitle}</p></div></div>
    <div class="interest-grid">
      {researchAreas.map((area) => (
        <article class="interest-card">
          <div class="interest-top"><span class="interest-number">{area.id}</span><span aria-hidden="true" class="interest-symbol">{area.id === '01' ? '◈' : area.id === '02' ? '✺' : '✳'}</span></div>
          <h3>{area.title[lang]}</h3>
          <p>{area.description[lang]}</p>
          <div class="interest-tags">{area.tags.map(tag => <span>{tag}</span>)}</div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section publications-section" id="selected-publications" aria-labelledby="featured-publications">
  <div class="shell">
    <div class="section-heading section-heading--split"><div><p class="section-eyebrow">02 / PUBLICATIONS</p><h2 id="featured-publications">{t.sectionPubs}</h2><p>{t.pubsSubtitle}</p></div><a class="text-link" href={route('publications',lang)}>{t.allPublications}<span aria-hidden="true">↗</span></a></div>
    <div class="publication-list">{selectedPubs.map((item,index) => <Publication item={item} index={index+1} compact />)}</div>
  </div>
</section>

<section class="section projects-section" id="selected-projects" aria-labelledby="featured-projects">
  <div class="shell">
    <div class="section-heading section-heading--split"><div><p class="section-eyebrow">03 / PROJECTS</p><h2 id="featured-projects">{t.sectionProjects}<span class="heading-sparkle" aria-hidden="true"> ✧</span></h2><p>{t.projectsSubtitle}</p></div><a class="text-link" href={route('projects',lang)}>{t.allProjects}<span aria-hidden="true">↗</span></a></div>
    <div class="project-grid">{selectedProjects.map(item => <ProjectCard item={item} lang={lang}/>)}</div>
  </div>
</section>

<section class="section updates-section" aria-labelledby="updates-heading">
  <div class="shell">
    <div class="updates-grid">
      <div class="updates-left">
        <div class="section-heading"><div><p class="section-eyebrow">04 / UPDATES</p><h2 id="updates-heading">{t.sectionNews}</h2><p>{t.newsSubtitle}</p></div></div>
        <div class="news-list">{news.slice(0,4).map(n => <div class="news-item"><time>{n.date}</time><span>{n[lang]}</span></div>)}</div>
        <a class="text-link" href={route('about',lang)}>{t.moreNews}<span aria-hidden="true">↗</span></a>
      </div>
      <aside class="connect-card">
        <div class="connect-stars" aria-hidden="true"><span>✴</span><span>✧</span><span>✦</span></div>
        <p class="connect-label">05 / CONNECT</p>
        <h2>{t.sectionReach}</h2>
        <p>{t.reachIntro}</p>
        <a href={'mailto:' + email} class="button button-light">{t.reachBtn}<span aria-hidden="true">↗</span></a>
        <div class="connect-bottom">LET'S MAKE SOMETHING MEANINGFUL <span aria-hidden="true">✳</span></div>
      </aside>
    </div>
  </div>
</section>
